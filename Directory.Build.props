<Project>
  <!-- Shared settings for every project in the solution. -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Authors>Deskswap contributors</Authors>
    <Product>Deskswap</Product>
    <Description>Swap virtual desktops between monitors on Windows — one shared pool of desktops, each monitor shows one.</Description>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
</Project>
